---
// Native registration form — Yoga Sessions (type "shakti") and Nadi Shodhana workshop (type "heal").
// Posts to the Apps Script Web App (site.WEBAPP_URL); the script logs it to Database_Log and,
// if an email is given, emails the WhatsApp group link as a backup.
import { site, SRC_MAP } from '../data/site.js';
const { type = 'shakti', button = 'Register →' } = Astro.props;
const reg = site.registration[type];
const WEBAPP_URL = site.WEBAPP_URL || '';
const defaultSource = reg.defaultSource;
const waGroup = reg.waGroup || '';
const waDirect = site.whatsappDirect;
const heal = type === 'heal';
const eventsUrl = heal ? (site.eventsCsvUrl || '') : '';
const ages = ['18-24', '25-34', '35-44', '45-54', '55-64', '65+'];
const codes = ['+91', '+1', '+44', '+971', '+65', '+61'];
const reasons = ['Stress/anxiety', 'BP/Hypertension', 'Weight', 'Flexibility/mobility', 'General wellness', 'Other'];
const fid = 'rf-' + type;
const waIcon = '<svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15L2 22l5.1-1.3A10 10 0 1 0 12 2zm0 18a8 8 0 0 1-4.1-1.1l-.3-.2-3 .8.8-2.9-.2-.3A8 8 0 1 1 12 20zm4.4-6c-.2-.1-1.4-.7-1.6-.8s-.4-.1-.5.1-.6.8-.8 1-.3.2-.5.1a6.6 6.6 0 0 1-3.3-2.9c-.2-.4.2-.4.6-1.2.1-.2 0-.3 0-.5s-.5-1.3-.7-1.7-.4-.4-.5-.4h-.5a1 1 0 0 0-.7.3A3 3 0 0 0 6 8.9c0 1.8 1.3 3.5 1.5 3.7s2.6 4 6.3 5.4c2.3.9 2.3.6 2.7.6s1.4-.6 1.6-1.1.2-1 .1-1.1z"/></svg>';
---
<div class="rform-wrap" id={fid}>
  <form class="rform" novalidate>
    <label class="fld">
      <span>Full name <b class="req" aria-hidden="true">*</b></span>
      <input name="name" type="text" autocomplete="name" maxlength="80" required />
    </label>

    <div class="fld">
      <span id={fid + '-ph'}>WhatsApp number <b class="req" aria-hidden="true">*</b></span>
      <div class="phone" role="group" aria-labelledby={fid + '-ph'}>
        <select name="cc" aria-label="Country code" required>
          {codes.map((c) => <option value={c}>{c}</option>)}
          <option value="other">Other</option>
        </select>
        <input name="ccOther" type="text" inputmode="numeric" maxlength="4" placeholder="e.g. 63" aria-label="Your country dialing code (digits)" hidden />
        <input name="mobile" type="tel" autocomplete="tel-national" inputmode="numeric" maxlength="15" placeholder="Mobile number" aria-label="Mobile number" required />
      </div>
      <small class="hint">Your active WhatsApp number — without the country code, no spaces. This is how we'll send you the joining details.</small>
    </div>

    <label class="fld">
      <span>Email <em>(optional)</em></span>
      <input name="email" type="email" autocomplete="email" inputmode="email" maxlength="120" />
      <small class="hint">We'll email you the WhatsApp group link too, in case you need it again.</small>
    </label>

    <div class="row2">
      <label class="fld">
        <span>City <em>(optional)</em></span>
        <input name="city" type="text" autocomplete="address-level2" maxlength="60" />
      </label>
      <label class="fld">
        <span>Age group <b class="req" aria-hidden="true">*</b></span>
        <select name="age" required>
          <option value="">Select…</option>
          {ages.map((a) => <option value={a}>{a}</option>)}
        </select>
      </label>
    </div>

    <label class="fld">
      <span>What brings you here? <em>(optional)</em></span>
      <select name="reason">
        <option value="">Select…</option>
        {reasons.map((r) => <option value={r}>{r}</option>)}
      </select>
    </label>

    <label class="fld">
      <span>Any health conditions we should know about? <em>(optional)</em></span>
      <textarea name="health" rows="3" maxlength="500" placeholder="e.g., BP, past surgery, injuries"></textarea>
      <small class="hint">This helps us guide you safely. It stays private and is used only for that.</small>
    </label>

    <label class="consent">
      <input name="consent" type="checkbox" required />
      <span>I agree that Yoga Shakti may contact me on WhatsApp about this {heal ? 'workshop' : 'programme'}, and I've read the <a href="/privacy/">privacy policy</a>.</span>
    </label>

    <!-- honeypot: hidden from humans, catches bots -->
    <input class="hp" type="text" name="company" tabindex="-1" autocomplete="off" aria-hidden="true" />

    <p class="err" role="alert" hidden></p>
    <button class="btn rbtn" type="submit">{button}</button>
    <p class="fineprint">We'll only use your details for this registration and occasional practice invitations. No spam — unsubscribe anytime.</p>
  </form>

  <div class="rthanks card" hidden tabindex="-1">
    <h2>Namaste<span class="t-name"></span> 🙏</h2>
    <p class="t-lead">You're registered for {heal ? 'the Nadi Shodhana workshop' : 'the Live Yoga Sessions'}.</p>
    {waGroup ? (
      <div class="t-step">
        <span class="t-kicker">One last step</span>
        <p>Join the WhatsApp group. {heal ? 'The invite and joining link are shared there.' : 'The joining link for each class is shared there.'}</p>
        <p><a class="cta wa" href={waGroup} target="_blank" rel="noopener"><Fragment set:html={waIcon} /> Join the WhatsApp group</a></p>
        <p class="t-note">Please join now, before you close this page.</p>
      </div>
    ) : (
      <p>We'll message you on WhatsApp shortly with the group link and joining details.</p>
    )}
    {heal ? (
      <p class="t-when" data-next-workshop hidden></p>
    ) : (
      <p class="t-when">
        {site.schedule.filter((s) => s.show).map((s, i) => (
          <span data-sched={s.key}>{i > 0 && <br />}<span data-f="when">Every {s.days}</span> · <span data-f="time">{s.time}</span></span>
        ))}
      </p>
    )}
    {heal && <p>We are glad that you have chosen this step in your yogic journey. 🌿</p>}
    <p>{heal ? 'See you soon' : 'See you on the mat'} 🧘‍♂️</p>
    <p class="t-sign">In the service of divinity within you,<br /><b>Ashish Anant</b></p>
    <p class="note">Questions? <a href={waDirect} target="_blank" rel="noopener">Message us on WhatsApp</a>.</p>
  </div>
</div>

<script define:vars={{ fid, type, WEBAPP_URL, SRC_MAP, defaultSource, eventsUrl }}>
  (function () {
    var wrap = document.getElementById(fid);
    if (!wrap) return;
    var form = wrap.querySelector('form');
    var err = wrap.querySelector('.err');
    var btn = wrap.querySelector('.rbtn');
    var thanks = wrap.querySelector('.rthanks');
    var label = btn.textContent;

    // SOURCE: known ?src shortcut -> SRC_MAP; otherwise a safe tag passes through (e.g. Website-Events)
    var qs = new URLSearchParams(location.search);
    var raw = qs.get('src') || '';
    var source = SRC_MAP[raw.toLowerCase()] || (/^[A-Za-z0-9-]{2,40}$/.test(raw) ? raw : defaultSource);
    // Lead ID from a comment→DM link (?ref=L…) so the engine updates that lead instead of adding a new one
    var ref = qs.get('ref') || '';
    if (!/^[A-Za-z0-9-]{3,40}$/.test(ref)) ref = '';

    // Nadi: show the next workshop date from the Events sheet on the thank-you screen
    if (eventsUrl) {
      var slot = thanks.querySelector('[data-next-workshop]');
      var MON = {jan:0,feb:1,mar:2,apr:3,may:4,jun:5,jul:6,aug:7,sep:8,oct:9,nov:10,dec:11};
      var pd = function (s) { s = (s || '').trim(); var m = s.match(/^(\d{1,2})[-\/\s]([A-Za-z]{3,})[-\/\s](\d{4})$/);
        if (m && MON[m[2].slice(0,3).toLowerCase()] != null) return new Date(+m[3], MON[m[2].slice(0,3).toLowerCase()], +m[1]);
        m = s.match(/^(\d{4})-(\d{2})-(\d{2})$/); return m ? new Date(+m[1], +m[2]-1, +m[3]) : null; };
      fetch(eventsUrl + (eventsUrl.indexOf('?') > -1 ? '&' : '?') + 'cb=' + Date.now()).then(function (r) { return r.ok ? r.text() : ''; }).then(function (t) {
        var rows = t.split(/\r?\n/).map(function (l) { var o = [], c = '', q = false; for (var i = 0; i < l.length; i++) { var ch = l[i];
          if (q) { if (ch === '"') { if (l[i+1] === '"') { c += '"'; i++; } else q = false; } else c += ch; }
          else if (ch === '"') q = true; else if (ch === ',') { o.push(c); c = ''; } else c += ch; } o.push(c); return o; });
        var h = rows.findIndex(function (r) { var l = r.map(function (x) { return x.toLowerCase().trim(); }); return l.indexOf('title') > -1 && l.indexOf('date') > -1; });
        if (h < 0) return; var H = rows[h].map(function (x) { return x.toLowerCase().trim(); });
        var iD = H.indexOf('date'), iT = H.indexOf('time'), iS = H.indexOf('status');
        var today = new Date(); today.setHours(0,0,0,0); var best = null;
        rows.slice(h + 1).forEach(function (r) { var d = pd(r[iD]); if (!d || d < today) return;
          if (iS > -1 && (r[iS] || '').trim().toLowerCase() === 'cancelled') return;
          if (!best || d < best.d) best = { d: d, t: (iT > -1 ? r[iT] : '') || '' }; });
        if (best && slot) {
          var M = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
          slot.textContent = 'Next workshop · ' + best.d.getDate() + ' ' + M[best.d.getMonth()] + ' ' + best.d.getFullYear() + (best.t ? ' · ' + best.t.trim() : '');
          slot.hidden = false;
        }
      }).catch(function () {});
    }

    form.cc.addEventListener('change', function () {
      var o = form.cc.value === 'other';
      form.ccOther.hidden = !o;
      if (o) form.ccOther.focus();
    });

    function fail(msg, el) { err.textContent = msg; err.hidden = false; if (el) el.focus(); }

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      err.hidden = true;
      if (form.company.value) return; // bot

      var name = form.name.value.trim();
      var cc = form.cc.value === 'other' ? form.ccOther.value.replace(/\D/g, '') : form.cc.value.replace('+', '');
      var mobile = form.mobile.value.replace(/\D/g, '').replace(/^0+/, '');
      var email = form.email.value.trim();
      if (!name) return fail('Please enter your name.', form.name);
      if (!cc) return fail('Please type your country dialing code (digits only).', form.ccOther);
      if (mobile.length < 6 || mobile.length > 14) return fail('Please enter your WhatsApp number (digits only, without the country code).', form.mobile);
      if (email && !/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) return fail('Please check your email address, or leave it empty.', form.email);
      if (!form.age.value) return fail('Please choose your age group.', form.age);
      if (!form.consent.checked) return fail('Please tick the box so we can contact you on WhatsApp.', form.consent);
      if (!WEBAPP_URL) return fail('Registration is not connected yet — please message us on WhatsApp.');

      btn.disabled = true; btn.textContent = 'Registering…';
      var payload = {
        type: type,
        name: name.slice(0, 80),
        countryCode: '+' + cc,
        mobile: mobile,
        whatsapp: '+' + cc + mobile,
        email: email.slice(0, 120),
        city: form.city.value.trim().slice(0, 60),
        ageGroup: form.age.value,
        reason: form.reason.value,
        health: form.health.value.trim().slice(0, 500),
        consent: true,
        source: source,
        ref: ref,
        page: location.pathname
      };

      fetch(WEBAPP_URL, {
        method: 'POST', mode: 'no-cors',
        headers: { 'Content-Type': 'text/plain;charset=utf-8' },
        body: JSON.stringify(payload)
      }).then(function () {
        try { if (window.gtag) gtag('event', 'generate_lead', { form: type, source: source }); } catch (e2) {}
        var first = name.split(/\s+/)[0];
        thanks.querySelector('.t-name').textContent = first ? ', ' + first : '';
        form.hidden = true;
        thanks.hidden = false;
        thanks.focus();
        thanks.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }).catch(function () {
        btn.disabled = false; btn.textContent = label;
        fail('Something went wrong sending your details. Please try again, or message us on WhatsApp.');
      });
    });
  })();
</script>

<style>
  .rform .fld { display: block; margin-bottom: 14px; }
  .rform .fld > span { display: block; font-weight: 500; font-size: 14px; margin-bottom: 5px; color: var(--ink); }
  .rform em { color: var(--muted); font-style: normal; font-weight: 400; }
  .rform .req { color: #a3341f; font-weight: 500; }
  .rform input[type=text], .rform input[type=tel], .rform input[type=email], .rform select, .rform textarea {
    width: 100%; padding: 11px 13px; border: 1px solid var(--line); border-radius: 10px;
    font: inherit; color: var(--ink); background: #fff; box-sizing: border-box;
  }
  .rform textarea { resize: vertical; min-height: 76px; }
  .rform input:focus, .rform select:focus, .rform textarea:focus { outline: none; border-color: var(--teal); box-shadow: 0 0 0 3px rgba(14,74,94,.12); }
  .rform .phone { display: flex; gap: 8px; }
  .rform .phone select { flex: 0 0 96px; width: 96px; }
  .rform .phone input[name=ccOther] { flex: 0 0 84px; width: 84px; }
  .rform .phone input[name=mobile] { flex: 1 1 auto; min-width: 0; }
  .rform .row2 { display: grid; grid-template-columns: 1fr 1fr; gap: 0 14px; }
  .rform .hint { display: block; color: var(--muted); font-size: 12px; margin-top: 4px; line-height: 1.45; }
  .rform .consent { display: flex; gap: 10px; align-items: flex-start; font-size: 13.5px; line-height: 1.5; margin: 4px 0 14px; }
  .rform .consent input { margin-top: 3px; width: 18px; height: 18px; flex: 0 0 18px; accent-color: var(--teal); }
  .rform .consent a { color: var(--teal); }
  .rform .hp { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }
  .rform .err { color: #a3341f; font-size: 14px; margin: 4px 0 10px; }
  .rform .rbtn { width: 100%; }
  .rform .fineprint { color: var(--muted); font-size: 12px; margin-top: 10px; line-height: 1.5; }
  .rthanks { text-align: center; }
  .rthanks h2 { margin-top: 0; }
  .rthanks:focus { outline: none; }
  .rthanks .t-lead { font-size: 17px; }
  .rthanks .t-step { border: 1.5px solid var(--gold); border-radius: 16px; padding: 16px 18px 12px; margin: 16px auto; max-width: 480px; background: #fff; }
  .rthanks .t-kicker { display: block; font-weight: 500; letter-spacing: .1em; text-transform: uppercase; font-size: 13px; color: #a3341f; margin-bottom: 4px; }
  .rthanks .cta.wa { display: inline-flex; align-items: center; justify-content: center; gap: 8px; background: #1f8f4e; font-weight: 500; white-space: nowrap; padding: 12px 22px; }
  .rthanks .t-when [data-f="time"] { white-space: nowrap; }
  .rthanks .t-note { font-size: 13px; color: var(--muted); margin-top: 6px; }
  .rthanks .t-when { display: inline-block; background: var(--cream); border-radius: 10px; padding: 7px 14px; font-size: 14px; line-height: 1.6; font-variant-numeric: tabular-nums; }
  .theme-heal .rthanks .t-when { background: #EEF8FB; }
  .rthanks .t-sign { margin-top: 14px; }
  @media (max-width: 560px) { .rform .row2 { grid-template-columns: 1fr; } }
</style>
