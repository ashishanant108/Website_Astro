---
// Works out the next live class (Schedule tab) or next workshop (Events tab) in the browser and fills
// [data-next-*], [data-save*] and [data-cal-buttons] inside the nearest .reg-root. Used by the
// registration pages and the Yogic Breathing Guide page.
import { site } from '../data/site.js';
const { type = 'shakti' } = Astro.props;   // 'shakti' = weekly sessions · 'heal' = next Nadi workshop
const heal = type === 'heal';
const scheduleUrl = heal ? '' : (site.scheduleCsvUrl || '');
const eventsUrl = heal ? (site.eventsCsvUrl || '') : '';
const fallback = heal ? [] : site.schedule.filter((s) => s.show).map((s) => ({ name: s.name, days: s.days, time: s.time }));
---
<script define:vars={{ type, scheduleUrl, eventsUrl, fallback }}>
  (function () {
    var root = document.querySelector('.reg-root'); if (!root) return;
    var IST = 330, DAY = 864e5;
    var WD = { sun: 0, mon: 1, tue: 2, wed: 3, thu: 4, fri: 5, sat: 6 };
    var RR = ['SU', 'MO', 'TU', 'WE', 'TH', 'FR', 'SA'];
    var MON = { jan:0,feb:1,mar:2,apr:3,may:4,jun:5,jul:6,aug:7,sep:8,oct:9,nov:10,dec:11 };

    function csv(t) { var rows = [], row = [], cur = '', q = false;
      for (var i = 0; i < t.length; i++) { var c = t[i];
        if (q) { if (c === '"') { if (t[i+1] === '"') { cur += '"'; i++; } else q = false; } else cur += c; }
        else if (c === '"') q = true; else if (c === ',') { row.push(cur); cur = ''; }
        else if (c === '\n') { row.push(cur); rows.push(row); row = []; cur = ''; } else if (c !== '\r') cur += c; }
      if (cur !== '' || row.length) { row.push(cur); rows.push(row); } return rows; }
    function table(t, must) { var rows = csv(t); var h = rows.findIndex(function (r) { var l = r.map(function (x) { return x.toLowerCase().trim(); }); return must.every(function (m) { return l.some(function (x) { return x.indexOf(m) === 0; }); }); });
      if (h < 0) return []; var H = rows[h].map(function (x) { return x.toLowerCase().trim(); });
      return rows.slice(h + 1).map(function (r) { var o = {}; H.forEach(function (k, i) { o[k] = (r[i] || '').trim(); }); return o; }); }
    function col(o, name) { for (var k in o) if (k.indexOf(name) === 0) return o[k]; return ''; }
    function parseTime(s) { var m = String(s).match(/(\d{1,2})(?::(\d{2}))?\s*(?:[–-]\s*(\d{1,2})(?::(\d{2}))?)?\s*(AM|PM)/i); if (!m) return null;
      var ap = m[5].toUpperCase(), fix = function (h) { h = +h % 12; return ap === 'PM' ? h + 12 : h; };
      var h = fix(m[1]), mi = +(m[2] || 0), dur = 60;
      if (m[3]) { var eh = fix(m[3]), em = +(m[4] || 0); dur = (eh * 60 + em) - (h * 60 + mi); if (dur <= 0) dur = 60; }
      return { h: h, m: mi, dur: dur }; }
    function utc(y, mo, d, h, mi) { return new Date(Date.UTC(y, mo, d, h, mi) - IST * 60000); }
    function istParts(t) { var x = new Date(t.getTime() + IST * 60000); return { y: x.getUTCFullYear(), mo: x.getUTCMonth(), d: x.getUTCDate(), wd: x.getUTCDay() }; }
    function fmt(t, tz) { var o = { weekday: 'short', day: 'numeric', month: 'short' }; if (tz) o.timeZone = tz;
      var d = new Intl.DateTimeFormat('en-GB', o).format(t).replace(',', '');
      var to = { hour: 'numeric', minute: '2-digit', hour12: true }; if (tz) to.timeZone = tz;
      return d + ' · ' + new Intl.DateTimeFormat('en-US', to).format(t); }
    function rel(t) { var a = istParts(new Date()), b = istParts(t); var n = Math.round((Date.UTC(b.y, b.mo, b.d) - Date.UTC(a.y, a.mo, a.d)) / DAY);
      return n <= 0 ? 'today' : n === 1 ? 'tomorrow' : 'in ' + n + ' days'; }
    function gcal(t, dur, title, byday) { var z = function (d) { return d.toISOString().replace(/[-:]/g, '').replace(/\.\d{3}/, ''); };
      var u = 'https://calendar.google.com/calendar/render?action=TEMPLATE&text=' + encodeURIComponent(title) + '&dates=' + z(t) + '/' + z(new Date(t.getTime() + dur * 60000)) +
        '&details=' + encodeURIComponent('The joining link is shared in the Yoga Shakti WhatsApp group before each ' + (type === 'heal' ? 'workshop.' : 'session.') + '\nhttps://ashishanant.com');
      if (byday) u += '&recur=' + encodeURIComponent('RRULE:FREQ=WEEKLY;BYDAY=' + byday); return u; }
    var CAL = '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/></svg>';
    function esc(s) { return String(s).replace(/[&<>"]/g, function (c) { return { '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;' }[c]; }); }

    // Sessions: next occurrence of each weekly row
    function sessions(rows) {
      var now = new Date(), items = [];
      rows.forEach(function (r) {
        var days = (String(r.days).toLowerCase().match(/(sun|mon|tue|wed|thu|fri|sat)/g) || []).map(function (x) { return WD[x]; });
        var tm = parseTime(r.time); if (!days.length || !tm) return;
        var next = null;
        for (var k = 0; k < 8 && !next; k++) { var p = istParts(new Date(now.getTime() + k * DAY)); if (days.indexOf(p.wd) < 0) continue;
          var t = utc(p.y, p.mo, p.d, tm.h, tm.m); if (t > now) next = t; }
        if (next) items.push({ t: next, dur: tm.dur, name: r.name || 'Live Yoga', days: r.days, time: r.time, byday: days.map(function (d) { return RR[d]; }).join(',') });
      });
      return items;
    }
    // Workshop: next upcoming, not cancelled
    function workshop(rows) {
      var today = istParts(new Date()), best = null;
      rows.forEach(function (r) {
        if ((col(r, 'status') || '').toLowerCase() === 'cancelled') return;
        var ty = (col(r, 'type') || '').toLowerCase(); if (ty && ty !== 'workshop') return;
        var ds = col(r, 'date'), m = ds.match(/^(\d{1,2})[-\/\s]([A-Za-z]{3,})[-\/\s](\d{4})$/), y, mo, d;
        if (m && MON[m[2].slice(0,3).toLowerCase()] != null) { d = +m[1]; mo = MON[m[2].slice(0,3).toLowerCase()]; y = +m[3]; }
        else if ((m = ds.match(/^(\d{4})-(\d{2})-(\d{2})$/))) { y = +m[1]; mo = +m[2] - 1; d = +m[3]; } else return;
        if (Date.UTC(y, mo, d) < Date.UTC(today.y, today.mo, today.d)) return;
        var tm = parseTime(col(r, 'time')) || { h: 19, m: 0, dur: 90 };
        var hrs = parseFloat(col(r, 'duration')); var dur = hrs > 0 ? Math.round(hrs * 60) : 90;
        var t = utc(y, mo, d, tm.h, tm.m); if (t < new Date()) return;
        if (!best || t < best.t) best = { t: t, dur: dur, name: col(r, 'title') || 'Nadi Shodhana workshop', mode: col(r, 'location') };
      });
      return best;
    }

    function paint(items) {
      var first = items.reduce(function (m, x) { return !m || x.t < m.t ? x : m; }, null), nonIST = new Date().getTimezoneOffset() !== -IST;
      root.querySelectorAll('[data-next-card]').forEach(function (el) { el.hidden = !first; });
      root.querySelectorAll('[data-next-none]').forEach(function (el) { el.hidden = !!first; });
      if (!first) return;
      root.querySelectorAll('[data-next-date]').forEach(function (el) { el.textContent = fmt(first.t, 'Asia/Kolkata') + ' IST'; });
      root.querySelectorAll('[data-next-rel]').forEach(function (el) { el.textContent = rel(first.t); });
      root.querySelectorAll('[data-next-local]').forEach(function (el) { if (nonIST) { el.textContent = 'Your time: ' + fmt(first.t); el.hidden = false; } });
      root.querySelectorAll('[data-next-extra]').forEach(function (el) { el.textContent = [first.mode, first.dur ? 'about ' + first.dur + ' minutes' : ''].filter(Boolean).join(' · '); });
      // thank-you: save the date + calendar buttons
      root.querySelectorAll('[data-save]').forEach(function (el) { el.hidden = false; });
      root.querySelectorAll('[data-save-line]').forEach(function (el) {
        el.innerHTML = (type === 'heal' ? 'Workshop: ' : 'First class: ') + esc(fmt(first.t, 'Asia/Kolkata')) + ' IST' + (nonIST ? '<br><span class="small">Your time: ' + esc(fmt(first.t)) + '</span>' : ''); });
      root.querySelectorAll('[data-cal-buttons]').forEach(function (el) {
        el.innerHTML = items.map(function (it) {
          var label = type === 'heal' ? 'Add to Google Calendar' : it.days + ' · ' + new Intl.DateTimeFormat('en-US', { timeZone: 'Asia/Kolkata', hour: 'numeric', minute: '2-digit', hour12: true }).format(it.t);
          return '<a class="btn ghost cal" href="' + gcal(it.t, it.dur, 'Yoga Shakti · ' + it.name, it.byday) + '" target="_blank" rel="noopener">' + CAL + ' ' + esc(label) + '</a>';
        }).join(''); });
    }

    var url = type === 'heal' ? eventsUrl : scheduleUrl;
    if (type !== 'heal') paint(sessions(fallback));
    if (url) fetch(url + (url.indexOf('?') > -1 ? '&' : '?') + 'cb=' + Date.now())
      .then(function (r) { return r.ok ? r.text() : Promise.reject(); })
      .then(function (txt) {
        if (type === 'heal') { var w = workshop(table(txt, ['title', 'date'])); paint(w ? [w] : []); }
        else {
          var rows = table(txt, ['key', 'days']).filter(function (r) { return r.key && (col(r, 'show') || 'yes').toLowerCase() !== 'no'; })
            .map(function (r) { return { name: col(r, 'session'), days: col(r, 'days'), time: col(r, 'time') }; });
          if (rows.length) paint(sessions(rows));
        }
      }).catch(function () { if (type === 'heal') paint([]); });
    else if (type === 'heal') paint([]);
  })();
</script>
