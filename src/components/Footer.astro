---
import { site } from '../data/site.js';
import Socials from './Socials.astro';
const fnav = [
  { label: "About", href: "/about/" },
  { label: "Lineage", href: "/lineage/" },
  { label: "Sessions", href: "/sessions/" },
  { label: "Nadi Shodhana", href: "/nadi-shodhana/" },
  { label: "Schedule", href: "/events/" },
  { label: "Resources", href: "/resources/" },
  { label: "Research", href: "/research/" },
  { label: "Reading", href: "/reading/" },
  { label: "Testimonials", href: "/testimonials/" },
  { label: "Contact", href: "/contact/" },
  { label: "Privacy", href: "/privacy/" },
  { label: "Terms", href: "/terms/" }
];
---
<footer class="site-foot">
  <div class="footwrap">
    <div class="follow-label">Follow along</div>
    <Socials />
    <nav class="fnav">
      {fnav.map((n) => <a href={n.href}>{n.label}</a>)}
    </nav>
    <p class="foot-note">
      New practice every week — come say hello.
      For general updates you can also <a href={site.whatsappCommunity} target="_blank" rel="noopener">join the announcements community</a>.
    </p>
    <div class="om">॥ SHIVOHAM ॥</div>
  </div>
</footer>
