---
import { site } from '../data/site.js';
const fnav = [
  { label: "About", href: "/about/" },
  { label: "Sessions", href: "/sessions/" },
  { label: "Nadi Shodhana", href: "/nadi-shodhana/" },
  { label: "Testimonials", href: "/testimonials/" },
  { label: "Contact", href: "/contact/" },
  { label: "Privacy", href: "/privacy/" }
];
---
<footer class="site-foot">
  <div class="footwrap">
    <div class="follow-label">Follow along</div>
    <div class="followrow">
      {site.socials.map((s) => (
        <a href={s.href} target="_blank" rel="noopener" aria-label={s.label} style={`background:${s.color}`}>
          <i class={`ti ti-${s.icon}`} aria-hidden="true"></i>
        </a>
      ))}
    </div>
    <nav class="fnav">
      {fnav.map((n) => <a href={n.href}>{n.label}</a>)}
    </nav>
    <div class="om">॥ SHIVOHAM ॥ · <a href={`mailto:${site.contact.general}`}>{site.contact.general}</a></div>
  </div>
</footer>
