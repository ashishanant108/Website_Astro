---
import Base from '../layouts/Base.astro';
const studies = [
  {
    benefit: "Calms stress &amp; anxiety — out of &ldquo;fight-or-flight&rdquo;",
    items: [
      {
        title: "How Breath-Control Can Change Your Life: A Systematic Review on Psycho-Physiological Correlates of Slow Breathing",
        src: "Frontiers in Human Neuroscience, 2018",
        url: "https://www.ncbi.nlm.nih.gov/pmc/articles/PMC6137615/",
        take: "A review of the evidence found that slow breathing (under ~10 breaths a minute) shifts the nervous system toward parasympathetic (&ldquo;rest and digest&rdquo;) activity and is linked to greater calm, emotional control and wellbeing."
      },
      {
        title: "Effect of short-term practice of pranayamic breathing exercises on cognition, anxiety, general well-being and heart rate variability",
        src: "Journal of the Indian Medical Association, 2013 · randomised, 96 medical students",
        url: "https://pubmed.ncbi.nlm.nih.gov/24968492/",
        take: "Six weeks of pranayama (Bhastrika and Anulom Vilom) improved anxiety and general wellbeing, and shifted heart-rate variability towards parasympathetic (&ldquo;rest and digest&rdquo;) activity. The comparison group, which practised Surya Namaskar, did not show these changes in anxiety or heart-rate variability."
      }
    ]
  },
  {
    benefit: "May help lower blood pressure",
    items: [
      {
        title: "Effectiveness of Alternative Nostril Breathing on Blood Pressure: A Systematic Review and Meta-Analysis of Randomized Controlled Trials",
        src: "Complementary Medicine Research (Karger), 2024 · 6 randomised trials, 525 people",
        url: "https://karger.com/cmr/article-abstract/31/5/449/910373/Effectiveness-of-Alternative-Nostril-Breathing-on",
        take: "Pooling six randomised trials, alternate-nostril breathing was linked to lower blood pressure: about 7 mmHg systolic and 5 mmHg diastolic compared with control groups. Results varied between studies, and the authors call for more high-quality trials."
      },
      {
        title: "Alternate-Nostril Yoga Breathing Reduced Blood Pressure While Increasing Performance in a Vigilance Test",
        src: "Medical Science Monitor Basic Research, 2017 · 15 healthy men with yoga experience",
        url: "https://pubmed.ncbi.nlm.nih.gov/29284770/",
        take: "One 18-minute session of alternate-nostril breathing lowered systolic blood pressure. Participants also completed an attention test faster afterwards (as they did after quiet sitting), with no rise in errors."
      }
    ]
  },
  {
    benefit: "Focus, memory &amp; emotional balance",
    items: [
      {
        title: "Pranayamas and Their Neurophysiological Effects",
        src: "International Journal of Yoga, 2020 · systematic review",
        url: "https://pubmed.ncbi.nlm.nih.gov/33343147/",
        take: "A systematic review of how different pranayamas act on the brain and the autonomic nervous system. Effects differ by technique (for example breath retention or a longer exhale), and the authors call for more focused studies."
      },
      {
        title: "Effect of short-term practice of pranayamic breathing exercises on cognition, anxiety, general well-being and heart rate variability",
        src: "Journal of the Indian Medical Association, 2013",
        url: "https://pubmed.ncbi.nlm.nih.gov/24968492/",
        take: "The same trial (see above) also found better memory scores in the pranayama group after six weeks."
      }
    ]
  },
  {
    benefit: "Breathing &amp; lung function",
    items: [
      {
        title: "Effect of Yoga Breathing (Pranayama) on Exercise Tolerance in Patients with Chronic Obstructive Pulmonary Disease: A Randomized, Controlled Trial",
        src: "Journal of Alternative and Complementary Medicine, 2017 · pilot trial, 43 people with COPD",
        url: "https://pubmed.ncbi.nlm.nih.gov/28714735/",
        take: "Over 12 weeks, people who added pranayama to education walked further in a 6-minute walk test than those who had education alone, with small gains in breathing measures. A promising pilot; larger trials are needed."
      },
      {
        title: "Immediate Effect of Pranayama on Pulmonary Function in Healthy Adults: An Experimental Study",
        src: "Advances in Mind-Body Medicine, 2025 · 20 healthy students, no control group",
        url: "https://pubmed.ncbi.nlm.nih.gov/40982747/",
        take: "Lung-function readings were higher straight after one 60-minute pranayama session. A small, early study without a comparison group, so treat it as a first signal."
      }
    ]
  }
];
---
<Base title="The Science of Yogic Breathing · Yoga Shakti" description="Peer-reviewed research behind the benefits of yogic breathing (pranayama) — for stress, blood pressure, focus, and respiratory health." active="/resources/">
  <main class="wrap page">
    <div class="kicker">The evidence</div>
    <h1>The science of yogic breathing</h1>
    <p class="lead">Yogic breathing is an ancient practice — and modern research is catching up to what the tradition has long taught. Below are peer-reviewed studies behind the benefits we describe, grouped by what they show. Each links to its source so you can read further.</p>

    {studies.map((group) => (
      <div class="section">
        <h2 set:html={group.benefit}></h2>
        <div class="rstack">
          {group.items.map((s) => (
            <div class="card">
              <div class="study">
                <p class="study-take" set:html={s.take}></p>
                <p class="study-cite">
                  <a href={s.url} target="_blank" rel="noopener"><span set:html={s.title} /><span class="visually-hidden"> (opens in a new tab)</span></a>
                  <br /><span class="study-src">{s.src}</span>
                </p>
              </div>
            </div>
          ))}
        </div>
      </div>
    ))}

    <div class="section">
      <p class="note"><b>How we choose studies.</b> Peer-reviewed papers only, each linked to its source. We describe what each study actually found, including its size and limits. Last reviewed: October 2026.</p>
      <p class="note"><b>A gentle note.</b> This page is educational and not medical advice. Yogic breathing supports wellbeing, but it is not a substitute for medical care. If you have a heart, lung or blood-pressure condition — or you are pregnant — please learn under guidance and check with your doctor. Results vary from person to person.</p>
    </div>

    <div class="cta-row">
      <a class="cta" href="/guide/?src=research">Get the Yogic Breathing Guide</a>
    </div>
  </main>

  <style>
    .rstack { display: flex; flex-direction: column; gap: 14px; }
    .study-take { font-size: 15.5px; line-height: 1.55; margin: 0 0 10px; }
    .study-cite { margin: 0; font-size: 13.5px; line-height: 1.45; }
    .study-cite a { color: var(--teal); font-weight: 600; text-decoration: none; }
    .study-cite a:hover { text-decoration: underline; }
    .study-src { color: var(--muted); font-size: 12.5px; }
  </style>
</Base>
