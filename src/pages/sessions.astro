---
import Base from '../layouts/Base.astro';
import { site } from '../data/site.js';
import { testimonials } from '../data/testimonials.js';
const shakti = site.forms.shakti;
const register = shakti.url + '?usp=pp_url&' + shakti.entry + '=Website';
const t = testimonials.find(x => x.tag === 'sessions');
---
<Base title="Free Live Yoga Sessions · Yoga Shakti" description="Complimentary live, guided yoga sessions with Ashish Anant — breath, movement and stillness, in real time, together." active="/sessions/">
  <main class="wrap page">
    <div class="kicker">Live · with Ashish</div>
    <h1>Free Live Yoga Sessions</h1>
    <p class="hero-tag">Some things can't be learned from a screen alone. Every week I hold live, guided sessions — breath, movement, and stillness, in real time, together.</p>

    <div class="section">
      <h2>What you'll practise</h2>
      <p class="lead">A quiet hour to come back to yourself: gentle movement, guided pranayama, and stillness — with guidance as you go. No fee, no pressure. Beginner or seasoned, you're welcome.</p>
      <div class="chips">
        <span class="chip">Guided breath &amp; pranayama</span>
        <span class="chip">Gentle movement</span>
        <span class="chip">Stillness &amp; calm</span>
        <span class="chip">Beginner-friendly</span>
      </div>
    </div>

    <div class="section">
      <h2>Sessions &amp; pricing</h2>
      <div class="offers">
        <div class="offer">
          <div class="o-name">Morning practice<small>Weekly · India morning &amp; US morning times</small></div>
          <div class="price"><span class="was">₹1,500/mo</span><span class="free">FREE</span></div>
        </div>
        <div class="offer">
          <div class="o-name">Evening practice<small>Weekly · India evening time</small></div>
          <div class="price"><span class="was">₹1,000/mo</span><span class="free">FREE</span></div>
        </div>
      </div>
      <p class="note">Sessions are offered as seva — complimentary for now. Held at India-morning and US-morning times so friends in both regions can join comfortably.</p>
    </div>

    {t && (
      <div class="section">
        <h2>In their words</h2>
        <div class="tcard">
          <div class="q">“{t.quote}”</div>
          <div class="who"><img src={t.photo} alt={t.name} /><div><b>{t.name}</b><span>{t.place}</span></div></div>
        </div>
      </div>
    )}

    <div class="section">
      <h2>Reserve your spot</h2>
      <p class="lead">Register and I'll send you the joining details.</p>
      <div class="cta-row"><a class="cta" href={register} target="_blank" rel="noopener">Register — it's complimentary</a></div>
      <p class="note">Registering is how you get into the sessions group and receive the joining link. The <a href={site.whatsappCommunity} target="_blank" rel="noopener" style="color:var(--teal)">WhatsApp Community</a> is for general announcements only — it doesn't enrol you in the sessions.</p>
    </div>

    <div class="signoff">॥ SHIVOHAM ॥</div>
    <p><a class="back" href="/">← Back to all links</a></p>
  </main>
</Base>
