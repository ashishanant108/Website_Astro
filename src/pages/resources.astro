---
import Base from '../layouts/Base.astro';
import { site } from '../data/site.js';
const guide = "/guide/?src=website";
---
<Base title="Free Resources · Yoga Shakti" description="Complimentary guides, downloads and reading to begin and deepen your practice." active="/resources/">
  <main class="wrap page">
    <div class="kicker">For you</div>
    <h1>Free resources</h1>
    <p class="lead">Complimentary guides, downloads and reading to begin — and to deepen — your practice. More will be added here over time.</p>

    <!-- Stress Check (PSS-10) tool built & finalized; ACTIVATE after Phase 0 (before Phase 1) by uncommenting this card. Page lives at /stress-check/. -->
    <!--
    <div class="section">
      <div class="card">
        <span class="badge">Interactive · about 2 min · private</span>
        <h3>Stress Check (PSS-10)</h3>
        <p>Not sure how stressed you really are? Take this short, well-researched self-check to see where your stress is right now — worked out privately in your browser, with gentle next steps to feel calmer.</p>
        <a class="btn red" href="/stress-check/">Take the stress check →</a>
      </div>
    </div>
    -->

    <div class="section">
      <div class="card">
        <span class="badge">Guides &amp; Downloads</span>
        <h3>Reference material &amp; guides</h3>
        <div class="guide-feature">
          <a class="gf-cover" href={guide} aria-hidden="true" tabindex="-1"><img src="/assets/guide-cover.jpg" alt="" width="560" height="792" loading="lazy" /></a>
          <div class="gf-body">
            <span class="gf-tag">Free PDF · 3 steps · 5 minutes a day</span>
            <h4><a href={guide}>The Yogic Breathing Guide</a></h4>
            <p class="gf-desc">A simple yet powerful conscious breathing process.</p>
          </div>
          <div class="gf-benefits"><span>Reduces stress &amp; anxiety</span><span>Calms the nervous system</span><span>Sharper focus &amp; memory</span><span>Lowers blood pressure</span><span>Stronger breathing</span></div>
          <div class="gf-actions">
            <a class="btn" href={guide}>Get the guide →</a>
            <a class="gf-link" href="/research/">See the research →</a>
          </div>
        </div>
        <p class="note" style="margin-top:8px">More guides, downloads and reference material will be added here soon.</p>
      </div>
    </div>

    <div class="section">
      <div class="card">
        <span class="badge">Reading</span>
        <h3>Books for the journey</h3>
        <p>A short, carefully chosen reading list — books that inspire and orient the seeker, plus authentic works from our lineage.</p>
        <a class="btn ghost" href="/reading/">Browse the books →</a>
      </div>
    </div>

    <div class="section">
      <div class="card">
        <span class="badge">Additional Resources · from our lineage</span>
        <h3>Discourses on Yoga Scriptures — YouTube</h3>
        <ul class="rlist ic-list">
          <li><span class="ic yt"><svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M23 7.5a3 3 0 0 0-2.1-2.1C19 5 12 5 12 5s-7 0-8.9.4A3 3 0 0 0 1 7.5 31 31 0 0 0 .6 12 31 31 0 0 0 1 16.5a3 3 0 0 0 2.1 2.1C5 19 12 19 12 19s7 0 8.9-.4a3 3 0 0 0 2.1-2.1A31 31 0 0 0 23.4 12 31 31 0 0 0 23 7.5zM9.8 15.3V8.7l5.7 3.3z"/></svg></span><span><a href="https://www.youtube.com/watch?v=FMRhXn93sfQ&list=PLXIZhgO2mfLviYHy3IDbuA08akAOt7nT2" target="_blank" rel="noopener">Swara Yoga — full playlist</a>, explained by Ma Shakti Devpriya Ji.</span></li>
          <li><span class="ic yt"><svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M23 7.5a3 3 0 0 0-2.1-2.1C19 5 12 5 12 5s-7 0-8.9.4A3 3 0 0 0 1 7.5 31 31 0 0 0 .6 12 31 31 0 0 0 1 16.5a3 3 0 0 0 2.1 2.1C5 19 12 19 12 19s7 0 8.9-.4a3 3 0 0 0 2.1-2.1A31 31 0 0 0 23.4 12 31 31 0 0 0 23 7.5zM9.8 15.3V8.7l5.7 3.3z"/></svg></span><span><a href="https://www.youtube.com/watch?v=lQ4L7GQDyoU&list=PLXIZhgO2mfLue_ExCXeB1rQbmITcwKLUI" target="_blank" rel="noopener">Patanjali Yoga Sutras — discourse playlist</a>, explained by Acharya Agyaatadarshan Anandnath Ji.</span></li>
        </ul>
        <h3 style="margin-top:18px">Blogs of the Masters</h3>
        <ul class="rlist ic-list">
          <li><span class="ic blog"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg></span><span><a href="https://agyaatdarshan.wordpress.com/" target="_blank" rel="noopener">Acharya Agyaatadarshan Anandnath Ji — blog</a></span></li>
          <li><span class="ic blog"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg></span><span><a href="https://tattvashakti.wordpress.com/author/tattvashakti/" target="_blank" rel="noopener">Ma Shakti Devpriya Ji — Tattva Shakti blog</a></span></li>
        </ul>
      </div>
    </div>

  </main>

  <style>
    .chips { display: flex; flex-wrap: wrap; gap: 8px; margin: 10px 0; }
    .chip { background: #e8f0f2; color: var(--teal); font-weight: 500; font-size: 13px; padding: 5px 12px; border-radius: 20px; line-height: 1.3; }
    .ic-list { list-style: none; padding-left: 0; }
    .ic-list li { display: grid; grid-template-columns: 34px 1fr; gap: 10px; align-items: start; margin-bottom: 10px; }
    .ic { width: 34px; height: 34px; border-radius: 50%; display: grid; place-items: center; }
    .ic.yt { background: #FDECEC; color: #FF0000; }
    .ic.blog { background: #E8F0F2; color: var(--teal); }
    .guide-feature { display: grid; grid-template-columns: 132px 1fr; gap: 10px 20px; align-items: start; margin: 6px 0 4px; }
    .gf-cover { grid-row: span 3; }
    .gf-cover img { display: block; width: 100%; height: auto; border-radius: 10px; border: 1px solid var(--line); box-shadow: 0 6px 16px rgba(43,43,43,.10); }
    .gf-tag { display: inline-block; font-size: 11.5px; letter-spacing: .08em; text-transform: uppercase; color: #2e5b34; margin-bottom: 4px; }
    .guide-feature h4 { font-size: 20px; font-weight: 500; margin: 0 0 4px; }
    .guide-feature h4 a { color: var(--ink); text-decoration: none; }
    .guide-feature h4 a:hover { color: var(--teal); }
    .gf-desc { margin: 0 0 6px !important; color: var(--ink) !important; flex: none !important; }
    .gf-benefits, .gf-actions { grid-column: 2; }
    .gf-benefits { display: flex; flex-wrap: wrap; gap: 6px; margin: 0 0 14px; }
    .gf-benefits span { background: #fff; border: 1px solid var(--line); color: var(--muted); font-size: 12.5px; padding: 4px 11px; border-radius: 20px; line-height: 1.35; }
    .gf-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 18px; }
    .gf-actions .btn { align-self: auto; }
    .gf-link { font-size: 14px; color: var(--teal); }
    @media (max-width: 560px) { .guide-feature { grid-template-columns: 92px 1fr; gap: 0 16px; align-items: center; } .gf-body { display: contents; } .gf-cover { grid-row: 1 / span 2; margin-bottom: 14px; } .gf-tag { grid-column: 2; align-self: end; margin: 0 0 4px; } .guide-feature h4 { grid-column: 2; align-self: start; font-size: 19px; line-height: 1.25; margin: 0 0 14px; } .gf-desc, .gf-benefits, .gf-actions { grid-column: 1 / -1; } .gf-desc { margin: 0 0 12px !important; } }
  </style>
</Base>
