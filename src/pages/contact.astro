---
import Base from '../layouts/Base.astro';
import { site } from '../data/site.js';
---
<Base title="Contact · Yoga Shakti" description="Get in touch with Yoga Shakti with Ashish Anant." active="/contact/">
  <main class="wrap page">
    <div class="kicker">Say namaste</div>
    <h1>Contact</h1>
    <p class="hero-tag">For sessions, workshops, or anything else — reach out any time.</p>

    <div class="section">
      <div class="grid cols-3">
        <div class="card">
          <h3>Email</h3>
          <p>For general questions and anything that needs a considered reply.</p>
          <p><a href={`mailto:${site.contact.general}`} style="color:var(--teal)">{site.contact.general}</a><br />
          <span style="color:var(--muted)">Sessions &amp; workshops:</span> <a href={`mailto:${site.contact.workshops}`} style="color:var(--teal)">{site.contact.workshops}</a></p>
        </div>
        <div class="card">
          <h3>WhatsApp</h3>
          <p>For a quick question about a session or workshop — message us directly.</p>
          <p><a href={site.whatsappDirect} target="_blank" rel="noopener" style="color:var(--teal)">Message us on WhatsApp →</a></p>
        </div>
        <div class="card">
          <h3>Join the community</h3>
          <p>Our WhatsApp community for gentle updates on upcoming sessions and workshops.</p>
          <p><a href={site.whatsappCommunity} target="_blank" rel="noopener" style="color:var(--teal)">Join the WhatsApp community →</a></p>
        </div>
      </div>
      <p class="note" style="margin-top:18px">We usually reply within a day or two. For the fastest response, WhatsApp is best.</p>
    </div>

  </main>
</Base>
