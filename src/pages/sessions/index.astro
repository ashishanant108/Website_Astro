import Base from '../../layouts/Base.astro';
---
<Base title="Sessions · Yoga Shakti" description="Live yoga and pranayama sessions with Ashish Anant — guided, unhurried, rooted in the tradition." active="/sessions/">
  <main class="wrap page">
    <figure class="sess-hero"><img src="/assets/sessions-header-index.png" alt="Yoga Shakti — sessions with Ashish Anant" /></figure>
    <div class="kicker">Practise with Ashish Anant</div>
    <h1>Sessions</h1>
    <p class="lead">Come practise in real time — guided, unhurried, and rooted in the tradition. Choose where to begin.</p>
    <p>Some things can't be learned from a screen alone. These live sessions meet you where you are — whether you're taking your first breath‑aware steps or deepening a seasoned practice.</p>

    <div class="section">
      <div class="grid cols-2">
        <div class="card">
          <span class="badge">Live · Weekly</span>
          <h3>Yoga Sessions</h3>
          <p>Live, guided yoga — breath, movement and stillness, together each week. See the benefits, timings and how to join.</p>
          <a class="btn ghost" href="/sessions/yoga/">Explore Yoga Sessions →</a>
        </div>
        <div class="card">
          <span class="badge">Starting soon</span>
          <h3>Pranayama Sessions</h3>
          <p>Dedicated sessions in the yogic science of breath — to steady the mind, balance the energy, and prepare for deeper practice.</p>
          <a class="btn ghost" href="/sessions/pranayama/">Learn more →</a>
        </div>
      </div>
    </div>

    <div class="section">
      <div class="card">
        <span class="badge">One‑to‑one · Paid</span>
        <h3>Personal Consultation</h3>
        <p>A private, one‑to‑one session shaped entirely around you. Whether you're refining your practice, seeking a personalised breathing or pranayama plan, working with stress, sleep or focus, or wanting guidance on a specific area — the session meets your individual needs and goals.</p>
        <p>Because each consultation is tailored to the requirement, this is a <b>paid session</b>; the scope and fee are agreed in advance. To enquire or book, write to us and we'll take it forward personally.</p>
        <div class="cta-row"><a class="cta" href="mailto:yogashakti@ashishanant.com?subject=Personal%20Consultation%20enquiry">Email to enquire →</a></div>
      </div>
    </div>

  </main>
</Base>
