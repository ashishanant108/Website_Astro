---
import Base from '../layouts/Base.astro';

const scriptures = [
  { title: "Bhagavad Gita",
    why: "A timeless dialogue on Yoga, Dharma, action, knowledge, devotion and equanimity — showing how the principles of Yoga can be lived amidst the challenges of everyday life." },
  { title: "Yoga Sutras of Patanjali",
    why: "A remarkably concise exploration of the mind and the path of Yoga — from disciplined practice and the eight limbs to meditation and liberation." },
  { title: "Yogachudamani Upanishad",
    why: "An important Yoga Upanishad exploring Prana, Nadis, Chakras, Kundalini, Pranayama and the subtle dimensions of Yogic practice." },
  { title: "Hatha Yoga Pradipika (Swami Svatmarama), Gheranda Samhita & Shiva Samhita",
    why: "Classical scriptures covering Asana, Nadi Shodhana, Pranayama, Shatkarma, Mudra, Bandha, and more." }
];

const lineage = [
  { title: "Tattva Shakti Vigyaan — Introducing Tantra to Modern Man", author: "Ma Shakti Devpriya", lang: "English",
    why: "An accessible introduction to Tantra and the Tattvas for the contemporary seeker — a doorway into a deeper philosophical worldview of Tantra, beyond many of its popular misconceptions.",
    link: "https://shaktimultiversity.com/shop/tattva-shakti-vigyaan-introducing-tantra-to-modern-man" },
  { title: "Dhyana Sutras — Ancient Operating System for the Modern Mind", author: "Acharya Agyaatadarshan Anand Nath", lang: "English",
    why: "A contemporary exploration of dhyana and the inner workings of the mind, emerging from Acharyaji's own meditation retreats and experiential teaching. It moves beyond an intellectual understanding of meditation towards its practical, lived dimensions.",
    link: "https://www.amazon.in/DHYANA-SUTRAS-Ancient-operating-System/dp/9358694149" },
  { title: "The Silent Guru — The Song of Sri Dakshinamurti", author: "Acharya Agyaatadarshan Anand Nath", lang: "English",
    why: "A contemplative guide to Adi Shankaracharya's Dakshinamurti Stotram, based on the satsangs of Acharya Agyaatadarshan Anandnath. It offers a verse-by-verse commentary, contemplative reflections, practical exercises, a forty-day Dakshinamurti Sadhana, and complimentary guided meditation recordings for an immersive contemplative experience.",
    link: "https://shaktimultiversity.com/shop/the-silent-guru" }
];
---
<Base title="Reading & Reflection · Yoga Shakti" description="Authentic Yoga scriptures and works from our lineage — books to inspire, orient and deepen the seeker's journey." active="/reading/">
  <main class="wrap page">
    <div class="kicker">Reading &amp; reflection</div>
    <h1>Books for the journey</h1>
    <p class="lead">A few works to inspire and orient you — the classical scriptures at the root of the tradition, and authentic books from our lineage.</p>

    <div class="section">
      <h2>Authentic Yoga Scriptures</h2>
      <p>The classical yogic scriptures —</p>
      <div class="booklist">
        {scriptures.map((b) => (
          <div class="book">
            <h3>{b.title}</h3>
            <p class="bwhy">{b.why}</p>
          </div>
        ))}
      </div>
    </div>

    <div class="section">
      <h2>From our lineage</h2>
      <div class="booklist">
        {lineage.map((b) => (
          <div class="book">
            <h3>{b.title} <span class="lang">{b.lang}</span></h3>
            <p class="bauthor">{b.author} · from Ashish Anant's Guru</p>
            <p class="bwhy">{b.why}</p>
            <a class="blink" href={b.link} target="_blank" rel="noopener">View the book →</a>
          </div>
        ))}
      </div>
    </div>

    <div class="section">
      <h2>The real transmission is in practice</h2>
      <p>Books can point the way and keep the fire alive — but the heart of yoga is transmitted from teacher to student, breath to breath. When you're ready, come practise with us, or read about the <a href="/lineage/" style="color:var(--teal)">lineage</a> this practice flows from.</p>
      <div class="cta-row"><a class="cta" href="/sessions/yoga/">Practise with us →</a></div>
    </div>

  </main>
</Base>
