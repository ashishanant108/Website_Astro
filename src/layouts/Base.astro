---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
const {
  title = "Yoga Shakti with Ashish Anant",
  description = "Yoga rooted in Tantra and the classical texts — complimentary live sessions, a healing-breath workshop, and a breathing guide.",
  bodyClass = "",
  active = ""
} = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" href="/assets/logo.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/tabler-icons/2.47.0/iconfont/tabler-icons.min.css" />
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){ dataLayer.push(arguments); }
    gtag('consent','default',{'analytics_storage':'denied'});
  </script>
  <script>
    import '../scripts/site-client.js';
  </script>
</head>
<body class={bodyClass}>
  <Header active={active} />
  <slot />
  <Footer />

  <div id="consent">
    <div class="row">
      <span>We use cookies only for anonymous analytics. See our <a href="/privacy/">privacy note</a>.</span>
      <span>
        <button class="yes" onclick="setConsent(true)">Accept</button>
        <button class="no" onclick="setConsent(false)">Decline</button>
      </span>
    </div>
  </div>
</body>
</html>
